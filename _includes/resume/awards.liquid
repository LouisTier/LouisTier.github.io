{% comment %}
  Awards fold like the other CV entries: the title, then "Awarder · year" stay visible; the
  summary and, when there is one, a link (Video, Project or Website) fold below
{% endcomment %}
<div class="lb-topics lb-cv-entries">
  {% for content in data[1] %}
    {% assign lb_id = 'awards-' | append: forloop.index %}
    {% capture lb_when %}{% include resume/lb_dates.liquid start=content.date end=content.date %}{% endcapture %}
    {% assign lb_when = lb_when | strip %}
    <h3 class="lb-fold-title" id="{{ lb_id }}" data-toc-skip="">
      <button type="button" aria-expanded="false" aria-controls="fold-{{ lb_id }}"><span>{{ content.title }}</span></button>
    </h3>
    <p class="lb-fold-meta">
      {{ content.awarder }}{% if lb_when != '' %} · {{ lb_when }}{% endif %}
    </p>
    <div class="lb-fold-body" id="fold-{{ lb_id }}" hidden="until-found">
      {% if content.summary and content.summary != '' %}
        <p class="lb-cv-summary">{{ content.summary }}</p>
      {% endif %}
      {% if content.url and content.url != '' %}
        {% if content.url contains 'youtube' or content.url contains 'youtu.be' %}
          {% assign lb_label = 'Video' %}
        {% elsif content.url contains '/projects/' %}
          {% assign lb_label = 'Project' %}
        {% else %}
          {% assign lb_label = 'Website' %}
        {% endif %}
        <div class="lb-research-links">
          <a class="btn btn-sm z-depth-0" href="{{ content.url }}" role="button">{{ content.url_label | default: lb_label }}</a>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
