{%- assign clean_last = include.last | downcase | remove_accents -%}
{%- assign coauthor_url = nil -%}
{%- if site.data.coauthors[clean_last] -%}
  {%- for coauthor in site.data.coauthors[clean_last] -%}
    {%- if coauthor.firstname contains include.first -%}
      {%- assign coauthor_url = coauthor.url -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign is_self = false -%}
{%- if site.scholar.last_name contains include.last -%}
  {%- if site.scholar.first_name contains include.first -%}
    {%- assign is_self = true -%}
  {%- endif -%}
{%- endif -%}
{%- if is_self -%}<em>{{ include.first }} {{ include.last }}</em>{%- elsif coauthor_url -%}<a href="{{ coauthor_url }}">{{ include.first }} {{ include.last }}</a>{%- else -%}{{ include.first }} {{ include.last }}{%- endif -%}
